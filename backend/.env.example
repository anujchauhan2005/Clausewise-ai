# Optional: used by rag/qa.py to generate natural-language answers.
# If left empty, the app falls back to extractive answers (returns the most
# relevant chunk directly instead of an LLM-generated answer).
GROQ_API_KEY= 

# Model names (override if you want faster/smaller or larger/better models)
CLASSIFIER_MODEL=facebook/bart-large-mnli
SUMMARIZER_MODEL=sshleifer/distilbart-cnn-12-6
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
